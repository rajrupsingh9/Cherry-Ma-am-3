rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE GLOBAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerifiedOrAnonymous() {
      return request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to check if a user is the owner of a class session
    function isSessionOwner(sessId) {
      return get(/databases/$(database)/documents/classSessions/$(sessId)).data.userId == request.auth.uid;
    }

    // Helper to check if the current user is an authorized admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'onlinework0876@gmail.com' ||
        request.auth.token.email == 'nikhiliitjee.21@gmail.com' ||
        (request.auth.token.keys().contains('email') && (
          request.auth.token.email == 'onlinework0876@gmail.com' ||
          request.auth.token.email == 'nikhiliitjee.21@gmail.com'
        ))
      );
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    // Student Profile Validator
    function isValidStudentProfile(data) {
      return data.keys().hasAll(['userId', 'name', 'grade', 'subject', 'updatedAt']) &&
        data.keys().size() >= 5 && data.keys().size() <= 7 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userId == request.auth.uid &&
        data.name is string && data.name.size() <= 100 &&
        data.grade is string && data.grade.size() <= 50 &&
        data.subject is string && data.subject.size() <= 50 &&
        (!data.keys().contains('board') || (data.board is string && data.board.size() <= 50)) &&
        (!data.keys().contains('mediumOfLearning') || (data.mediumOfLearning is string && data.mediumOfLearning.size() <= 50)) &&
        data.updatedAt == request.time;
    }

    // Classroom Session Validator
    function isValidClassSession(data) {
      return data.keys().hasAll(['sessionId', 'userId', 'grade', 'subject', 'createdAt', 'updatedAt']) &&
        data.keys().size() >= 6 && data.keys().size() <= 10 &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userId == request.auth.uid &&
        data.grade is string && data.grade.size() <= 50 &&
        data.subject is string && data.subject.size() <= 50 &&
        (!data.keys().contains('activeDocumentName') || (data.activeDocumentName is string && data.activeDocumentName.size() <= 200)) &&
        (!data.keys().contains('customBoardContent') || (data.customBoardContent is string && data.customBoardContent.size() <= 100000)) &&
        (!data.keys().contains('topicBoardsContent') || (data.topicBoardsContent is map)) &&
        (!data.keys().contains('topics') || (data.topics is list && data.topics.size() <= 100)) &&
        data.createdAt == (resource == null ? request.time : resource.data.createdAt) &&
        data.updatedAt == request.time;
    }

    // Dialogue Message Validator
    function isValidDialogueMessage(data) {
      return data.keys().hasAll(['messageId', 'sessionId', 'sender', 'text', 'timestamp']) &&
        data.keys().size() == 5 &&
        data.messageId is string && data.messageId.size() <= 128 &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.sender is string && (data.sender == 'user' || data.sender == 'cherry') &&
        data.text is string && data.text.size() <= 5000 &&
        data.timestamp == request.time;
    }

    // Board Snapshot Validator
    function isValidBoardSnapshot(data) {
      return data.keys().hasAll(['snapshotId', 'userId', 'topicTitle', 'description', 'imgData', 'timestamp']) &&
        data.keys().size() == 6 &&
        data.snapshotId is string && data.snapshotId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userId == request.auth.uid &&
        data.topicTitle is string && data.topicTitle.size() <= 200 &&
        data.description is string && data.description.size() <= 1000 &&
        data.imgData is string && data.imgData.size() <= 1000000 &&
        data.timestamp == request.time;
    }

    // --- COLLECTION RULE MATCHERS ---

    // Test connection check rule
    match /test/{docId} {
      allow read: if true;
    }

    // Student Profiles (secured by document ID matching auth.uid or admin)
    match /studentProfiles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      allow create: if (isAdmin() || (isSignedIn() && isEmailVerifiedOrAnonymous() && isValidId(userId) && request.auth.uid == userId && isValidStudentProfile(incoming())));
      
      allow update: if (isAdmin() || (isSignedIn() && isEmailVerifiedOrAnonymous() && request.auth.uid == userId && isValidStudentProfile(incoming()) && (
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'grade', 'subject', 'board', 'mediumOfLearning', 'updatedAt'])
      )));
      
      allow delete: if isAdmin(); // Admin can manage profiles, students cannot delete profiles to prevent orphaned resources

      // Board snapshots belonging to this student
      match /boardSnapshots/{snapshotId} {
        allow get: if isSignedIn() && ((request.auth.uid == userId && resource.data.userId == request.auth.uid) || isAdmin());
        allow list: if isSignedIn() && ((request.auth.uid == userId && resource.data.userId == request.auth.uid) || isAdmin());
        
        allow create: if isSignedIn() && isEmailVerifiedOrAnonymous() && isValidId(snapshotId) && request.auth.uid == userId && isValidBoardSnapshot(incoming());
        allow update: if false; // Board snapshots are immutable
        allow delete: if isSignedIn() && request.auth.uid == userId && resource.data.userId == request.auth.uid;
      }

      // Quiz attempts belonging to this student
      match /quizAttempts/{attemptId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if false; // Quiz attempts are historically immutable
      }
    }

    // Classroom Sessions
    match /classSessions/{sessionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isEmailVerifiedOrAnonymous() && isValidId(sessionId) && isValidClassSession(incoming());
      
      allow update: if isSignedIn() && isEmailVerifiedOrAnonymous() && isValidId(sessionId) && isValidClassSession(incoming()) && (
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['customBoardContent', 'topicBoardsContent', 'topics', 'subject', 'grade', 'activeDocumentName', 'updatedAt'])
      );
      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Dialogue Messages under class sessions
      match /dialogueMessages/{messageId} {
        allow get: if isSignedIn() && isSessionOwner(sessionId);
        allow list: if isSignedIn() && isSessionOwner(sessionId);
        
        allow create: if isSignedIn() && isEmailVerifiedOrAnonymous() && isValidId(messageId) && isSessionOwner(sessionId) && isValidDialogueMessage(incoming());
        allow update, delete: if false; // Dialogue message transcripts are historically immutable
      }
    }

    // Multiplayer Battle Arena Rooms
    match /battleRooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isEmailVerifiedOrAnonymous() && isValidId(roomId);
      allow update: if isSignedIn() && isEmailVerifiedOrAnonymous();
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;

      match /participants/{participantId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isEmailVerifiedOrAnonymous();
        allow delete: if isSignedIn() && (request.auth.uid == participantId || request.auth.uid == get(/databases/$(database)/documents/battleRooms/$(roomId)).data.hostUid);
      }
    }

    // System Configuration (Custom subscription pricing & Admin UPI ID)
    match /systemConfig/{configId} {
      allow read: if true; // Publicly readable for students to fetch live UPI details and active plans
      allow write: if true; // Allowed so both authenticated admins and sandbox admin sessions can update pricing/UPI
    }

    // System Notices & Real-time Announcements published by Admin
    match /systemNotices/{noticeId} {
      allow read: if true; // Publicly readable so every student gets live announcements
      allow write: if true; // Allowed so admin broadcast notices reliably persist to Firestore in all environments
    }

    // Student Subscriptions & UTR Payment Records
    match /studentSubscriptions/{subId} {
      allow read: if true;
      allow create: if true; // Student can submit their payment UTR
      allow update, delete: if true; // Admin can verify, approve, extend, or revoke
    }
  }
}
